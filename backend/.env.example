# .env.example
# Copia este archivo como ".env" (sin ".example") y llena tus propios
# datos reales. El archivo ".env" NUNCA se sube a GitHub (está en
# .gitignore) porque contiene contraseñas y datos sensibles.

PORT=4000

DB_HOST=tu-host-de-tidb-cloud.aws.tidbcloud.com
DB_PORT=4000
DB_USER=tu_usuario
DB_PASSWORD=tu_contraseña
DB_NAME=nombre_de_la_base
